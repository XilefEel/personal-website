---
import { Icon } from "astro-icon/components";
import ProjectCard from "../cards/ProjectCard.astro";

const projects: {
  title: string;
  description: string;
  gradient: string;
  link: string;
  tech: string[];
  status: string;
}[] = [
  {
    title: "MindNest",
    description:
      "A desktop app for organizing your thoughts and tasks, all in one place.",
    gradient: "from-blue-500 to-purple-600",
    link: "https://github.com/XilefEel/MindNest",
    tech: ["React", "TypeScript", "Rust", "Tauri"],
    status: "Completed",
  },
  {
    title: "Cubit",
    description:
      "A browser-based voxel sandbox game built with Three.js and a Rust WebSocket server.",
    gradient: "from-green-500 to-teal-600",
    link: "https://github.com/XilefEel/cubit",
    tech: ["Typescript", "Three.js", "Rust"],
    status: "Completed",
  },
  {
    title: "Moss.md",
    description:
      "A simple and lightweight desktop Markdown previewer and editor",
    gradient: "from-orange-500 to-red-600",
    link: "https://github.com/XilefEel/moss-md",
    tech: ["React", "TypeScript", "Rust", "Tauri"],
    status: "Completed",
  },
  {
    title: "Hubbub",
    description: "A Discord-style chat app built around simplicity and privacy",
    gradient: "from-sky-500 to-blue-600",
    link: "https://github.com/XilefEel/hubbub",
    tech: ["React", "Typescript", "Go", "Pocketbase"],
    status: "In Progress",
  },
];
---

<section id="projects" class="bg-zinc-50 px-8 pb-16 md:px-12 md:pb-20">
  <div class="mx-auto flex max-w-4xl flex-col gap-8">
    <h3
      class="fade-in text-center text-3xl font-extrabold text-purple-500 md:text-4xl"
    >
      Featured Projects
    </h3>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="fade-in flex justify-center text-center">
      <a
        href="https://github.com/XilefEel"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-purple-600 shadow-sm transition-colors hover:bg-purple-50 hover:shadow-md"
      >
        <Icon name="lucide:github" class="size-5 shrink-0" />
        <span>View All Projects on GitHub</span>
        <Icon name="lucide:external-link" class="size-4 shrink-0" />
      </a>
    </div>
  </div>
</section>
