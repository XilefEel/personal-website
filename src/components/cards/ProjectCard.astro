---
import { Icon } from "astro-icon/components";

const { project } = Astro.props;

const statusStyles: Record<string, string> = {
  Completed: "bg-green-100 text-green-700",
  "In Progress": "bg-amber-100 text-amber-700",
};
---

<div class="fade-in">
  <div
    class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm transition-transform hover:scale-[1.01] hover:border-purple-500 hover:shadow-md"
  >
    <div class={`h-48 bg-linear-to-br ${project.gradient} relative`}>
      <div
        class={`absolute top-3 right-3 rounded-full px-3 py-1 text-xs font-semibold ${statusStyles[project.status]}`}
      >
        {project.status}
      </div>
    </div>

    <div class="p-6">
      <h3 class="mb-2 text-xl font-semibold text-zinc-900">{project.title}</h3>
      <p class="mb-4 text-sm text-zinc-600">{project.description}</p>

      <div class="flex flex-col gap-3">
        <div class="flex flex-wrap gap-2">
          {
            project.tech.map((tech: string) => (
              <span class="rounded-full bg-purple-100 px-3 py-1 text-xs text-purple-600">
                {tech}
              </span>
            ))
          }
        </div>

        <div class="border-t border-zinc-100 pt-2">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${project.title} on GitHub`}
            class="flex items-center gap-2 text-sm font-medium text-purple-600 transition-colors hover:text-purple-800"
          >
            <Icon name="lucide:github" class="size-4 shrink-0" />
            <span>View GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
